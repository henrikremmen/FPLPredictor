# Copy to .env and point at your backend.
#
# Simulator/emulator on the same machine as the backend:
#   EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
#
# Physical iPhone on the same Wi-Fi (run `FPL_API_HOST=0.0.0.0 python run_app.py`
# from the repo root first — it prints this value with your real IP filled in):
#   EXPO_PUBLIC_API_URL=http://192.168.1.23:8000
#
# A deployed HTTPS backend (see docs/deploy.md):
#   EXPO_PUBLIC_API_URL=https://api.example.com
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
