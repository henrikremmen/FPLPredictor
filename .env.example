# Optional: deadline odds snapshots from https://the-odds-api.com/
ODDS_API_KEY=



# Optional and credit-intensive: one event-odds request per EPL fixture.
# Enables anytime-goalscorer and over/under 0.5 assist probabilities.
ODDS_PLAYER_PROPS=0

# Optional: cup, European and international schedules from https://football-data.org/
FOOTBALL_DATA_API_KEY=

# Optional: the "Ask Claude" chat in the web app.
# 1. Create a key at https://console.anthropic.com/settings/keys (API keys > Create key).
#    The account needs credits under Billing.
# 2. Put it in the .env file in the project folder (copy this file to .env if you have none),
#    right after the = sign, without quotes or spaces:
#    ANTHROPIC_API_KEY=sk-ant-api03-...
# 3. Open the web app, load your team and click "Ask Claude". No restart needed.
# The key is read only by the local Python API and never reaches the browser; do not put it
# under frontend/ or in a VITE_ variable. Model: claude-sonnet-5-5 at medium effort. Estimated cost:
# about $0.37 for the first question of a chat (it sends ~90k tokens of forecast and team data once,
# cached for an hour), then about $0.02-0.04 per follow-up question within that hour.
ANTHROPIC_API_KEY=
